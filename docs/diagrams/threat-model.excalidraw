      "x": 614,
      "y": 360,
      "width": 330,
      "height": 32,
      "text": "CAUGHT: unknown tool, out-of-scope path/domain,",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-23",
      "x": 614,
      "y": 392,
      "width": 330,
      "height": 32,
      "text": "a missing constrained argument (denied, not",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-24",
      "x": 614,
      "y": 424,
      "width": 330,
      "height": 32,
      "text": "defaulted), and any later edit of the decision log.",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "notdefended-25",
      "x": 40,
      "y": 500,
      "width": 900,
      "height": 120,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": {
        "type": 3
      },
      "strokeStyle": "solid",
      "boundElements": []
    },
    {
      "type": "text",
      "id": "text-26",
      "x": 54,
      "y": 512,
      "width": 870,
      "height": 35,
      "text": "NOT DEFENDED: agent-guard governs tool calls, not the model's reasoning. It cannot",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-27",
      "x": 54,
      "y": 544,
      "width": 870,
      "height": 35,
      "text": "stop a prompt injection from forming a malicious intent - it stops that intent from",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-28",
      "x": 54,
      "y": 576,
      "width": 870,
      "height": 35,
      "text": "reaching a tool it isn't authorized to use. Pair it with prompt-shield on the input edge.",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    }
